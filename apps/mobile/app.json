{
  "expo": {
    "name": "ChampionsSport",
    "slug": "championssport",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "championssport",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.championssport.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E17"
      },
      "package": "com.championssport.app"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
